{-| Decode an `I18n` from Json. Make sure this is _only_ used on the files generated by this package.
You need to pass the language of the loaded translations (for bookkeeping).
-}
decodeMessages : Language -> Json.Decode.Decoder (I18n -> I18n)
decodeMessages lang =
    Json.Decode.array Json.Decode.string
        |> Json.Decode.map (\arr (I18n opts bundles) -> I18n opts { bundles | messages = ( arr, lang ) })


intParser : Parser.Parser Int
intParser =
    Parser.chompWhile Char.isDigit
        |> Parser.getChompedString
        |> Parser.andThen
            (String.toInt >> Maybe.map Parser.succeed >> Maybe.withDefault (Parser.problem "Expected int"))


parser : List Char -> Array.Array String -> Parser.Parser ( String, Maybe Char )
parser endSymbols args =
    let
        getArg n =
            Array.get n args |> Maybe.withDefault ""

        endParsers state =
            (Parser.succeed (Parser.Done ( state, Maybe.Nothing )) |. Parser.end)
                :: List.map
                    (\symbol ->
                        Parser.succeed (Parser.Done ( state, Maybe.Just symbol ))
                            |. Parser.token (String.fromChar symbol)
                    )
                    ('}' :: endSymbols)

        escapeParsers state =
            List.map
                (\symbol -> Parser.succeed (Parser.Loop (state ++ symbol)) |. Parser.token ("\\" ++ symbol))
                [ "{", "}", "\\", "|" ]
    in
    Parser.loop "" <|
        \state ->
            Parser.oneOf
                (endParsers state
                    ++ escapeParsers state
                    ++ [ Parser.succeed (Parser.Loop <| state ++ "{") |. Parser.token "\\{"
                       , Parser.succeed (Parser.Loop <| state ++ "}") |. Parser.token "\\}"
                       , Parser.succeed ((++) state >> Parser.Loop)
                            |. Parser.token "{"
                            |= Parser.oneOf [ Parser.succeed getArg |= intParser |. Parser.token "}" ]
                       , Parser.chompWhile (\c -> '{' :: '}' :: '\\' :: endSymbols |> List.member c |> not)
                            |> Parser.getChompedString
                            |> Parser.map ((++) state >> Parser.Loop)
                       ]
                )


{-| Replaces all placeholders with the given arguments using the Intl API on the marked spots
-}
replacePlaceholders : List String -> String -> String
replacePlaceholders argList =
    Parser.run (parser [] (Array.fromList argList)) >> Result.map Tuple.first >> Result.toMaybe >> Maybe.withDefault ""


languageToFileName_messages : Language -> String
languageToFileName_messages lang =
    case lang of
        EnUS ->
            "messages.en-US.3916728715.json"

        ZhCmnHansCN ->
            "messages.zh-cmn-Hans-CN.1839923733.json"

        ZhCmnHantTW ->
            "messages.zh-cmn-Hant-TW.3842321837.json"
