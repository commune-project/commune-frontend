{
  "name": "commune-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "i18n:generate": "travelm-agency translations --elm_path=src/Generated/I18n.elm --json_path=public/assets/i18n --hash && node scripts/prune-i18n.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "compile": "elm make src/Main.elm --output=public/elm.js",
    "dev": "npm run i18n:generate && npm run compile && vite --host 127.0.0.1",
    "build": "npm run i18n:generate && elm make src/Main.elm --optimize --output=public/elm.js && vite build",
    "format": "elm-format src tests --yes",
    "format:check": "elm-format src tests --validate",
    "test": "node --test tests-js/*.test.js && elm-test",
    "test:browser": "playwright test",
    "release:stage": "node scripts/stage-release.mjs"
  },
  "dependencies": {
    "lossless-json": "4.3.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "elm": "0.19.1-6",
    "elm-format": "0.8.8",
    "elm-test": "0.19.1-revision17",
    "travelm-agency": "3.8.0",
    "vite": "7.3.7"
  }
}
